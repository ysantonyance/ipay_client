# Only needed for a deployed build. In development the Vite proxy forwards /api to the backend.
# VITE_API_URL=https://your-backend.example.com/api

# Dev only: `npm run dev` also starts the ASP.NET backend. Put this in .env.local (gitignored)
# - it is the folder that contains ExamTest.WebApi.csproj on YOUR machine.
# IPAY_BACKEND_PATH=C:\path\to\IPAY_backend\src\ExamTest.WebApi
# Set to false to start the backend yourself instead.
# START_BACKEND=false

# Temporary passcode for the /admin playground (see src/context/AdminAuthContext.jsx).
# There's no real admin account system yet - replace this with proper auth once one exists.
# Defaults to "admin" if unset.
# VITE_ADMIN_PASSCODE=change-me
